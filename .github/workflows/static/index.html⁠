<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>itsmepuliyt TikTok Enhancer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #0b0f19; color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        .glass { background: rgba(17, 24, 39, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .glow { box-shadow: 0 0 25px rgba(236, 72, 153, 0.2); }
    </style>
</head>
<body class="min-h-screen pb-12 flex flex-col items-center px-3 sm:px-6">
    <header class="w-full max-w-4xl my-4 sm:my-6 glass p-4 rounded-2xl glow flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="p-2.5 bg-pink-600 rounded-xl text-white font-black text-lg sm:text-xl"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
            <div>
                <h1 class="text-base sm:text-lg font-bold bg-gradient-to-r from-pink-500 to-violet-500 bg-clip-text text-transparent">itsmepuliyt TikTok Enhancer</h1>
                <p class="text-[11px] text-gray-400">PUBG HD Video Bitrate Preservation Engine</p>
            </div>
        </div>
        <div id="serverStatus" class="px-2.5 py-1 bg-green-950 text-green-400 border border-green-800 rounded-full text-[11px] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span> Online
        </div>
    </header>

    <main class="w-full max-w-4xl grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <div class="glass p-5 sm:p-6 rounded-2xl flex flex-col justify-between">
            <div>
                <h2 class="text-base font-bold mb-3 flex items-center gap-2 text-pink-400"><i class="fa-solid fa-file-video"></i> Select Video</h2>
                
                <div id="dropZone" class="border-2 border-dashed border-gray-700 hover:border-pink-500 rounded-2xl p-6 sm:p-8 text-center cursor-pointer transition active:scale-98">
                    <i class="fa-solid fa-cloud-arrow-up text-3xl sm:text-4xl text-gray-500 mb-2"></i>
                    <p class="text-xs sm:text-sm text-gray-300 font-medium">Tap to Choose Video from iPhone</p>
                    <p class="text-[10px] sm:text-xs text-gray-500 mt-1">Camera Roll / Photo Library / Files</p>
                    <input type="file" id="videoInput" class="hidden" accept="video/*">
                </div>

                <div id="fileInfo" class="hidden mt-3 p-3 bg-gray-900 rounded-xl text-xs flex justify-between items-center">
                    <span id="fileName" class="font-medium text-pink-300 truncate max-w-[180px]">video.mp4</span>
                    <span id="fileSize" class="text-gray-400">0 MB</span>
                </div>

                <div class="mt-5 space-y-3">
                    <div>
                        <label class="text-xs font-semibold text-gray-400 flex justify-between">
                            <span>Metadata Multiplier</span>
                            <span id="multiplierValue" class="text-pink-400 font-bold">10x</span>
                        </label>
                        <input type="range" id="multiplier" min="1" max="20" value="10" class="w-full accent-pink-500 mt-1">
                    </div>
                </div>
            </div>

            <button id="processBtn" class="w-full mt-5 py-3 bg-gradient-to-r from-pink-600 to-violet-600 hover:from-pink-500 hover:to-violet-500 active:scale-98 rounded-xl font-bold text-white text-sm shadow-lg shadow-pink-900/30 transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-bolt"></i> Enhance Video for TikTok
            </button>
        </div>

        <div class="glass p-5 sm:p-6 rounded-2xl flex flex-col justify-between">
            <h2 class="text-base font-bold mb-3 flex items-center gap-2 text-violet-400"><i class="fa-solid fa-chart-line"></i> Processing Status</h2>

            <div id="statusBox" class="flex-grow flex flex-col items-center justify-center border border-gray-800 rounded-2xl p-6 text-center min-h-[160px]">
                <i class="fa-solid fa-film text-4xl text-gray-700 mb-2"></i>
                <p class="text-xs text-gray-400">Select a video and tap Enhance to start process.</p>
            </div>

            <div id="outputContainer" class="hidden space-y-3 mt-3">
                <video id="videoPreview" controls playsinline class="w-full rounded-xl border border-gray-800 max-h-52 bg-black"></video>
                <a id="downloadBtn" download class="w-full py-3 bg-green-600 hover:bg-green-500 text-white font-bold rounded-xl text-center block text-sm transition">
                    <i class="fa-solid fa-download mr-1"></i> Save Enhanced Video
                </a>
            </div>
        </div>
    </main>

    <script>
        const videoInput = document.getElementById('videoInput');
        const dropZone = document.getElementById('dropZone');
        const processBtn = document.getElementById('processBtn');
        const multiplier = document.getElementById('multiplier');
        const multiplierValue = document.getElementById('multiplierValue');
        const statusBox = document.getElementById('statusBox');
        const outputContainer = document.getElementById('outputContainer');
        const videoPreview = document.getElementById('videoPreview');
        const downloadBtn = document.getElementById('downloadBtn');

        multiplier.oninput = () => multiplierValue.innerText = multiplier.value + 'x';
        dropZone.onclick = () => videoInput.click();

        videoInput.onchange = (e) => {
            const file = e.target.files[0];
            if (file) {
                document.getElementById('fileName').innerText = file.name;
                document.getElementById('fileSize').innerText = (file.size / (1024*1024)).toFixed(1) + ' MB';
                document.getElementById('fileInfo').classList.remove('hidden');
            }
        };

        processBtn.onclick = async () => {
            if (!videoInput.files[0]) return alert('Please choose a video file first!');
            
            statusBox.innerHTML = '<i class="fa-solid fa-spinner animate-spin text-3xl text-pink-500 mb-2"></i><p class="text-xs text-gray-300">Enhancing video metadata...</p>';
            outputContainer.classList.add('hidden');

            const formData = new FormData();
            formData.append('file', videoInput.files[0]);
            formData.append('multiplier', multiplier.value);

            try {
                const res = await fetch('/api/process', { method: 'POST', body: formData });
                const data = await res.json();

                if (data.success) {
                    statusBox.innerHTML = '<i class="fa-solid fa-circle-check text-3xl text-green-400 mb-1"></i><p class="text-xs text-green-300 font-semibold">Video Ready for TikTok!</p>';
                    videoPreview.src = data.stream_output_url;
                    downloadBtn.href = data.download_url;
                    outputContainer.classList.remove('hidden');
                } else {
                    statusBox.innerHTML = `<p class="text-red-400 text-xs">Error: ${data.error}</p>`;
                }
            } catch (err) {
                statusBox.innerHTML = '<p class="text-red-400 text-xs">Failed to process video.</p>';
            }
        };
    </script>
</body>
</html>
